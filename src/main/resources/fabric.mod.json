{
	"schemaVersion": 1,
	"id": "memorypalace",
	"version": "${version}",
	"name": "Memory Palace",
	"description": "Keep Markdown and LaTeX notes on bookshelves in your world, and turn it into a memory palace.",
	"authors": [
		"congyuemao"
	],
	"contact": {
		"homepage": "https://github.com/congyuemao/memory-palace",
		"sources": "https://github.com/congyuemao/memory-palace",
		"issues": "https://github.com/congyuemao/memory-palace/issues"
	},
	"license": "MIT",
	"icon": "assets/memorypalace/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.memorypalace.MemoryPalace"
		],
		"client": [
			"com.memorypalace.client.MemoryPalaceClient"
		],
		"modmenu": [
			"com.memorypalace.client.ModMenuIntegration"
		]
	},
	"mixins": [
		"memorypalace.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.20.1",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*",
		"fabric-permissions-api-v0": "*"
	},
	"suggests": {
		"modmenu": "*"
	}
}
